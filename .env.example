# ================== 服务 ==================
# 宿主机映射端口（docker-compose.yml 的 ${HOST_PORT:-8000}）。
# 注意用 HOST_PORT 而不是 PORT：部分终端/环境会注入 PORT 变量，
# 导致 compose 插值变成随机端口（映射到 32768 之类的端口）。
HOST_PORT=8000

# ================== AI 分析（OpenAI 兼容协议） ==================
# 不填 LLM_API_KEY 也能跑：AI 分析会自动降级为内置规则引擎，
# 输出结构完全一致（含明确的四选一持仓建议），只是文字不如大模型灵活。
LLM_ENABLED=true

# --- DeepSeek（默认，国内直连、便宜） ---
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=

# --- 阿里通义千问 ---
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

# --- 月之暗面 Kimi ---
# LLM_BASE_URL=https://api.moonshot.cn/v1
# LLM_MODEL=moonshot-v1-32k

# --- 智谱 GLM ---
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-4-plus

# --- 本地 Ollama（容器内访问宿主机） ---
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_MODEL=qwen2.5:14b
# LLM_API_KEY=ollama
# LLM_JSON_MODE=false

# 单次 LLM 调用超时（秒）。主分析要生成最多 4000 token 的 JSON，
# DeepSeek 等公有云盘中高峰常需 60s 以上，45s 会掐断正常生成导致降级规则引擎。
LLM_TIMEOUT=90
LLM_MAX_TOKENS=4000
# 思考类模型（deepseek-reasoner / *-thinking / r1 等）思考过程也占输出配额，
# 检测到思考型模型或正文为空时自动放大到此值重试；不需要思考模型时可不管它。
LLM_THINKING_MAX_TOKENS=8192
LLM_TEMPERATURE=0.25
# 端点不支持 response_format=json_object 时设为 false
LLM_JSON_MODE=true

# ================== 数据源 ==================
# 故障转移顺序，东方财富为主，其余为辅
PROVIDER_ORDER=eastmoney,ths,tencent,sina,akshare
# AkShare 辅助兜底源（K线/资金流向）。开启需两步：
#   1) 镜像以 WITH_AKSHARE=true 构建（docker-compose.yml 默认已是 true，约 +400MB）；
#   2) 此处设为 true（容器运行时才会加载 akshare 数据源）。
# 不需要时可改回 false，同时把 docker-compose.yml 的 WITH_AKSHARE 改回 false 以减小镜像。
ENABLE_AKSHARE=true
HTTP_TIMEOUT=6
HTTP_RETRY=2

# ================== 缓存 TTL（秒） ==================
QUOTE_TTL_OPEN=2.5
QUOTE_TTL_CLOSED=60
HISTORY_TTL_OPEN=120
HISTORY_TTL_CLOSED=900
SEARCH_TTL=300
HOT_TTL=60

# ================== 业务参数 ==================
KLINE_LIMIT=260
FLOW_DAYS=30
MARGIN_DAYS=30

# ================== AI 评分权重 ==================
# 三维分面评分（技术面/资金面/消息面）的乘数，默认 1.0，范围 0.2~3.0。
# 调大某面让该维度信号更强（如消息面重仓者可调高 NEWS）。
# 设置页保存的权重优先于环境变量；保存后 AI 当日缓存自动失效。
SCORE_WEIGHT_TECH=1.0
SCORE_WEIGHT_CAPITAL=1.0
SCORE_WEIGHT_NEWS=1.0
